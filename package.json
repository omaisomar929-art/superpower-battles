{
  "name": "superpower-battles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"tsx server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 43127",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "remotion:studio": "npx remotion studio src/video/index.ts",
    "render:cli": "npx remotion render src/video/index.ts SuperpowerBattles out/superpower-battles.mp4"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.536",
    "@remotion/cli": "^4.0.536",
    "@remotion/player": "^4.0.536",
    "@remotion/renderer": "^4.0.536",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "remotion": "^4.0.536"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
